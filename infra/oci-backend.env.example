# OCI backend deployment environment.
# Store the real version as the GitHub secret OCI_BACKEND_ENV.

API_DOMAIN=api.swapassistant.app
ACME_EMAIL=admin@swapassistant.app

# This is overwritten by CI with the immutable GHCR image tag.
BACKEND_IMAGE=ghcr.io/madnaelo/wallet-backend:latest

POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change_me_to_a_long_random_password
DATABASE_URL=jdbc:postgresql://wallet-postgres:5432/wallet
DATABASE_USERNAME=wallet
DATABASE_PASSWORD=change_me_to_a_long_random_password

# Frontend URLs allowed to call the backend. Include the Vercel URL and custom domain.
FRONTEND_URL=https://swapassistant.app
FRONTEND_ORIGINS=https://swapassistant.app,https://wallet-integration.vercel.app

# Wallet sign-in message identity. This should describe the frontend the user is signing into.
AUTH_SIGNING_DOMAIN=swapassistant.app
AUTH_SIGNING_URI=https://swapassistant.app
SESSION_TTL_HOURS=168
NONCE_TTL_MINUTES=10
AUTH_SESSION_COOKIE_SAME_SITE=None
AUTH_SESSION_COOKIE_SECURE=true
# Vercel frontend + OCI API are different sites, so browsers may block third-party cookies.
# Expose a session token to the SPA; the frontend stores it in sessionStorage and sends it as a bearer token.
AUTH_EXPOSE_ACCESS_TOKEN=true

API_MAX_REQUEST_BODY_BYTES=1048576
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
API_AUTH_RATE_LIMIT_MAX_REQUESTS=20
API_RATE_LIMIT_KEY_PEPPER=change_me_to_a_random_secret_in_production
API_TRUST_FORWARDED_HEADERS=true
API_TRUST_PRIVATE_PROXY_HEADERS=true
API_TRUSTED_PROXY_CIDRS=

AUTO_SWAP_DEFAULT_ENABLED=false
LIMIT_ORDERS_DEFAULT_ENABLED=true
ADMIN_API_KEY=
ONEINCH_API_KEY=
ONEINCH_ORDERBOOK_BASE_URL=https://api.1inch.dev/orderbook/v4.1
LIMIT_ORDER_ORDERBOOK_SUBMISSION_ENABLED=true
LIMIT_ORDER_REQUEST_TIMEOUT_SECONDS=8
MAINTENANCE_CLEANUP_FIXED_DELAY_MS=3600000
DRY_RUN_HISTORY_RETENTION_DAYS=180
ALERT_RETENTION_DAYS=365
NOTIFICATION_OUTBOX_RETENTION_DAYS=30

NOTIFICATIONS_MONITOR_ENABLED=true
NOTIFICATIONS_MONITOR_FIXED_DELAY_MS=900000
NOTIFICATIONS_CANDIDATE_LIMIT=2000
NOTIFICATIONS_LOOKBACK_DAYS=90
NOTIFICATIONS_DEFAULT_PROFIT_THRESHOLD_BPS=100
NOTIFICATIONS_DEFAULT_LOSS_THRESHOLD_BPS=500
NOTIFICATIONS_DEFAULT_COOLDOWN_MINUTES=360
TELEGRAM_LINK_TTL_MINUTES=10
NOTIFICATIONS_OUTBOX_FIXED_DELAY_MS=15000
NOTIFICATIONS_OUTBOX_BATCH_SIZE=50
NOTIFICATIONS_OUTBOX_MAX_ATTEMPTS=8
NOTIFICATIONS_OUTBOX_LOCK_TTL_SECONDS=120
NOTIFICATIONS_ELIGIBLE_STATUSES=submitted,confirmed

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
COINGECKO_REQUEST_TIMEOUT_SECONDS=8
COINGECKO_CONTRACT_BATCH_SIZE=100

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=alerts@swapassistant.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true

TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BASE_URL=https://api.telegram.org

PUSH_NOTIFICATIONS_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:alerts@swapassistant.app

# Optional OCI PostgreSQL backups. Enable after confirming disk space and
# backup retention policy on the VM.
ENABLE_POSTGRES_BACKUP_TIMER=false
BACKUP_DIR=/home/opc/wallet/backups/postgres
BACKUP_RETENTION_DAYS=14
