# OCI backend deployment environment.
# Store the real version as the GitHub secret OCI_BACKEND_ENV.
APP_ENVIRONMENT=production

API_DOMAIN=api.swapassistant.app
ACME_EMAIL=admin@swapassistant.app

# This is overwritten by CI with the immutable GHCR image tag.
BACKEND_IMAGE=ghcr.io/madnaelo/wallet-backend:latest

POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change_me_to_a_long_random_password
DATABASE_URL=jdbc:postgresql://wallet-postgres:5432/wallet
DATABASE_USERNAME=wallet
DATABASE_PASSWORD=change_me_to_a_long_random_password
DATABASE_POOL_MAX_SIZE=12
DATABASE_POOL_MIN_IDLE=2
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_VALIDATION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=600000
DATABASE_MAX_LIFETIME_MS=1800000
DATABASE_KEEPALIVE_MS=300000

# Frontend URLs allowed to call the backend. Include the Vercel URL and custom domain.
FRONTEND_URL=https://swapassistant.app
FRONTEND_ORIGINS=https://swapassistant.app,https://wallet-integration-theta.vercel.app

# Wallet sign-in message identity. This should describe the frontend the user is signing into.
AUTH_SIGNING_DOMAIN=swapassistant.app
AUTH_SIGNING_URI=https://swapassistant.app
SESSION_TTL_HOURS=168
NONCE_TTL_MINUTES=10
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_COOKIE_PATH=/backend
AUTH_SESSION_COOKIE_SECURE=true
# The frontend proxies /backend to OCI, so authentication stays in an HttpOnly first-party cookie.
AUTH_EXPOSE_ACCESS_TOKEN=false

API_MAX_REQUEST_BODY_BYTES=1048576
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
API_AUTH_RATE_LIMIT_MAX_REQUESTS=20
API_RATE_LIMIT_KEY_PEPPER=change_me_to_a_random_secret_in_production
API_TRUST_FORWARDED_HEADERS=true
API_TRUST_PRIVATE_PROXY_HEADERS=true
API_TRUSTED_PROXY_CIDRS=

PRICE_ALERTS_DEFAULT_ENABLED=false
LIMIT_ORDERS_DEFAULT_ENABLED=true
ADMIN_API_KEY=
LIFI_BASE_URL=https://li.quest
LIFI_API_KEY=your_lifi_api_key_here
LIFI_STATUS_TRACKING_ENABLED=true
LIFI_STATUS_REQUEST_TIMEOUT_SECONDS=10
LIFI_STATUS_CHECK_FIXED_DELAY_MS=10000
LIFI_STATUS_CHECK_BATCH_SIZE=10
LIFI_STATUS_CHECK_LOCK_TTL_SECONDS=45
LIFI_STATUS_CHECK_MAX_BACKOFF_SECONDS=1800
LIFI_STATUS_MAXIMUM_TRACKING_HOURS=168
ONEINCH_API_KEY=
ONEINCH_ORDERBOOK_ENABLED=false
ONEINCH_ORDERBOOK_BASE_URL=https://api.1inch.com/orderbook/v4.1
COW_API_KEY=
COW_ORDERBOOK_BASE_URL=https://api.cow.fi
COW_PARTNER_ORDERBOOK_BASE_URL=https://partners.cow.fi
LIMIT_ORDER_ORDERBOOK_SUBMISSION_ENABLED=true
LIMIT_ORDER_REQUEST_TIMEOUT_SECONDS=8
LIMIT_ORDER_SUBMISSION_RETRY_FIXED_DELAY_MS=30000
LIMIT_ORDER_SUBMISSION_BATCH_SIZE=25
LIMIT_ORDER_SUBMISSION_MAX_ATTEMPTS=8
LIMIT_ORDER_SUBMISSION_LOCK_TTL_SECONDS=60
LIMIT_ORDER_STATUS_CHECK_FIXED_DELAY_MS=30000
LIMIT_ORDER_STATUS_CHECK_BATCH_SIZE=50
LIMIT_ORDER_STATUS_CHECK_LOCK_TTL_SECONDS=60
LIMIT_ORDER_STATUS_CHECK_OPEN_INTERVAL_SECONDS=60
LIMIT_ORDER_STATUS_CHECK_PARTIAL_INTERVAL_SECONDS=30
LIMIT_ORDER_STATUS_CHECK_MAX_BACKOFF_SECONDS=1800
MAINTENANCE_CLEANUP_FIXED_DELAY_MS=3600000
MAINTENANCE_DELETE_BATCH_SIZE=2000
MAINTENANCE_MAX_DELETE_BATCHES_PER_RUN=5
DRY_RUN_HISTORY_RETENTION_DAYS=180
ALERT_RETENTION_DAYS=365
NOTIFICATION_OUTBOX_RETENTION_DAYS=30

NOTIFICATIONS_MONITOR_ENABLED=true
NOTIFICATIONS_MONITOR_FIXED_DELAY_MS=900000
NOTIFICATIONS_CANDIDATE_LIMIT=2000
NOTIFICATIONS_LOOKBACK_DAYS=90
NOTIFICATIONS_DEFAULT_PROFIT_THRESHOLD_BPS=100
NOTIFICATIONS_DEFAULT_LOSS_THRESHOLD_BPS=500
NOTIFICATIONS_DEFAULT_COOLDOWN_MINUTES=360
TELEGRAM_LINK_TTL_MINUTES=10
NOTIFICATIONS_OUTBOX_FIXED_DELAY_MS=15000
NOTIFICATIONS_OUTBOX_BATCH_SIZE=50
NOTIFICATIONS_OUTBOX_MAX_ATTEMPTS=8
NOTIFICATIONS_OUTBOX_LOCK_TTL_SECONDS=120
NOTIFICATIONS_ELIGIBLE_STATUSES=submitted,confirmed

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
COINGECKO_REQUEST_TIMEOUT_SECONDS=15
COINGECKO_CONTRACT_BATCH_SIZE=100
COINGECKO_MAX_ATTEMPTS=2
COINGECKO_RETRY_DELAY_MS=1000

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=alerts@swapassistant.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000

TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BASE_URL=https://api.telegram.org

PUSH_NOTIFICATIONS_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:alerts@swapassistant.app
PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
PUSH_REQUEST_TIMEOUT_SECONDS=15
PUSH_MAX_DEVICES_PER_WALLET=10

# Optional OCI PostgreSQL backups. Enable after confirming disk space and
# backup retention policy on the VM. For production disaster recovery, set an
# Object Storage bucket and grant the VM instance principal permission to write
# objects to that bucket.
# Production releases enforce this value. Keep it enabled for manual deployments.
ENABLE_POSTGRES_BACKUP_TIMER=true
BACKUP_DIR=/home/opc/wallet/backups/postgres
BACKUP_RETENTION_DAYS=14
OCI_BACKUP_BUCKET=
OCI_BACKUP_NAMESPACE=
OCI_BACKUP_OBJECT_PREFIX=swap-assistant/postgres
OCI_BACKUP_AUTH_MODE=instance_principal
OCI_BACKUP_KMS_KEY_ID=
