{
  "name": "swap-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prepare-indexnow.mjs",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:preflight": "node --test scripts/tests/deployment-preflight.test.mjs scripts/tests/frontend-domain-env.test.mjs scripts/tests/indexnow.test.mjs",
    "preflight:demo": "node scripts/demo-preflight.mjs",
    "preflight:deployment": "node scripts/deployment-preflight.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "radar:build": "tsc -p tsconfig.radar.json",
    "radar:start": "node .market-radar/main.js",
    "radar:test": "vitest run src/market-radar",
    "radar:load": "node .market-radar/load-test.js"
  },
  "dependencies": {
    "@1inch/limit-order-sdk": "^5.3.0",
    "@base-org/account": "^2.5.6",
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@reown/appkit": "1.8.22",
    "@reown/appkit-adapter-bitcoin": "1.8.22",
    "@reown/appkit-adapter-ethers": "1.8.22",
    "@reown/appkit-adapter-solana": "1.8.22",
    "@solana/web3.js": "^1.98.4",
    "@walletconnect/sign-client": "^2.23.9",
    "bitcoin-address-validation": "3.0.0",
    "bitcoinjs-lib": "^7.0.1",
    "bigint-buffer": "file:vendor/bigint-buffer-safe",
    "ethers": "^6.13.2",
    "lucide-react": "1.48.0",
    "next": "^15.5.24",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "pg": "8.23.0",
    "@types/pg": "8.23.1",
    "ws": "^8.21.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.24",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "bigint-buffer": "$bigint-buffer",
    "@coinbase/cdp-sdk": "1.50.0",
    "axios": "^1.16.1",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2",
    "jayson": "4.1.3",
    "nanoid@^3": "^3.3.18",
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "uuid": "^11.1.1",
    "valibot": "^1.4.1",
    "viem": "^2.51.0",
    "ws": "^8.21.0"
  }
}
