# 0x API
ZEROX_API_KEY=your_0x_api_key_here

# Swap providers queried by the quote API. Providers without required keys are skipped.
SWAP_PROVIDERS=0x,1inch,paraswap,odos,lifi

# 1inch Business API
ONEINCH_API_KEY=your_1inch_api_key_here

# Public provider endpoints. Odos public API does not require a key; enterprise can use ODOS_API_KEY.
PARASWAP_BASE_URL=https://api.paraswap.io
PARASWAP_API_KEY=
PARASWAP_API_KEY_HEADER=X-API-Key
ODOS_BASE_URL=https://api.odos.xyz
ODOS_API_KEY=

# LI.FI is used for native Bitcoin receive quotes. API key and integrator are optional until portal setup.
LIFI_BASE_URL=https://li.quest
LIFI_API_KEY=
LIFI_INTEGRATOR=

# Platform fee collection. Replace FEE_RECIPIENT_ADDRESS with our wallet before enabling live fee collection.
AFFILIATE_ADDRESS=0x0000000000000000000000000000000000000000
FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
PLATFORM_FEE_BPS=20
PARASWAP_PARTNER=thewallet

# WalletConnect v2 (create a project at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Comma-separated chain IDs allowed by the app (MVP)
# Examples:
# - Ethereum mainnet: 1
# - Arbitrum One: 42161
# - Optimism: 10
# - Base: 8453
# - Polygon: 137
# - BNB Smart Chain: 56
# - Avalanche C-Chain: 43114
# - Sepolia: 11155111
NEXT_PUBLIC_ALLOWED_CHAIN_IDS=1,42161,10,8453,137,56,43114

# Guardrail: if true, do not submit approvals/swaps. Quote API calls can still use allowed chains.
NEXT_PUBLIC_DISALLOW_MAINNET=true

# Spring Boot backend. In production with a reverse proxy this can be /api/backend.
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# CORS allowlist for API routes (comma-separated). Use * only for local dev.
CORS_ALLOW_ORIGINS=http://localhost:3000
REQUIRE_ALLOWED_ORIGIN=false

# Spring Boot backend local defaults
DATABASE_URL=jdbc:postgresql://localhost:56434/wallet
DATABASE_USERNAME=wallet
DATABASE_PASSWORD=wallet
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=168
NONCE_TTL_MINUTES=10
AUTH_SIGNING_DOMAIN=localhost:3000
AUTH_SIGNING_URI=http://localhost:3000
AUTH_SESSION_COOKIE_SAME_SITE=Lax
AUTH_SESSION_COOKIE_SECURE=false
AUTH_EXPOSE_ACCESS_TOKEN=false
API_MAX_REQUEST_BODY_BYTES=1048576
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
API_AUTH_RATE_LIMIT_MAX_REQUESTS=20
API_RATE_LIMIT_KEY_PEPPER=change_me_to_a_random_secret_in_production
API_TRUST_FORWARDED_HEADERS=true
API_TRUST_PRIVATE_PROXY_HEADERS=true
API_TRUSTED_PROXY_CIDRS=

# Global feature switches
# Set ADMIN_API_KEY before using /api/admin/features/* endpoints.
AUTO_SWAP_DEFAULT_ENABLED=false
ADMIN_API_KEY=
MAINTENANCE_CLEANUP_FIXED_DELAY_MS=3600000
DRY_RUN_HISTORY_RETENTION_DAYS=180
ALERT_RETENTION_DAYS=365
NOTIFICATION_OUTBOX_RETENTION_DAYS=30

# Reverse-swap profit notifications
APP_URL=http://localhost:3000
NOTIFICATIONS_MONITOR_ENABLED=true
NOTIFICATIONS_MONITOR_FIXED_DELAY_MS=900000
NOTIFICATIONS_CANDIDATE_LIMIT=2000
NOTIFICATIONS_LOOKBACK_DAYS=90
NOTIFICATIONS_DEFAULT_PROFIT_THRESHOLD_BPS=100
NOTIFICATIONS_DEFAULT_COOLDOWN_MINUTES=360
TELEGRAM_LINK_TTL_MINUTES=10
NOTIFICATIONS_OUTBOX_FIXED_DELAY_MS=15000
NOTIFICATIONS_OUTBOX_BATCH_SIZE=50
NOTIFICATIONS_OUTBOX_MAX_ATTEMPTS=8
NOTIFICATIONS_OUTBOX_LOCK_TTL_SECONDS=120
NOTIFICATIONS_ELIGIBLE_STATUSES=submitted,confirmed
NOTIFICATIONS_DEFAULT_LOSS_THRESHOLD_BPS=500
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
COINGECKO_REQUEST_TIMEOUT_SECONDS=8
COINGECKO_CONTRACT_BATCH_SIZE=100
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BASE_URL=https://api.telegram.org
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:alerts@thewallet.app

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REDIS_PREFIX=wallet
RATE_LIMIT_REDIS_FAIL_OPEN=false

# Quote cache TTL
QUOTE_CACHE_TTL_MS=8000
QUOTE_CACHE_MAX_ENTRIES=2000
